# Keep credentials in the ignored .env file.
# Prefer API keys restricted to the required read permissions in Open Dental.
OPENDENTAL_DEVELOPER_KEY=your-developer-key
OPENDENTAL_CUSTOMER_KEY=your-customer-key

# Alternatively, replace BOTH lines above with the combined format:
# OPEN_DENTAL_API_KEY=developer-key/customer-key
# Optional: select the API Service on this machine (Remote is the default).
# OPEN_DENTAL_BASE_URL=http://127.0.0.1:30223/api/v1/
# For the workstation Local API, use port 30222 instead.
# No LAN hosts, custom ports, redirects, or write operations are supported.
